# Version control and development files
# .git MUST be listed: the WordPress.org deploy action rsyncs with
# --exclude-from=.distignore, and its own default excludes are skipped
# entirely when this file exists.
/.git
/.claude
/.github
/.wordpress-org
/node_modules
/scripts
/src
/vendor
.build-tmp

# Config files
.distignore
.editorconfig
.gitattributes
.gitignore
CLAUDE.md
README.md
deploy.sh
package.json
package-lock.json
webpack.config.js
blueprint.json
.nvmrc

# Build artifacts and OS files
*.zip
.gitkeep
.DS_Store

# Misc
*.log
